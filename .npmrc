# Do not run third-party postinstall/install scripts.
#
# Why: better-sqlite3 ships a binding.gyp, so npm auto-runs `node-gyp rebuild`
# for it — which fails on machines without Python + a C++ toolchain (and is
# pointless anyway, because v13 ships prebuilt binaries for win32, linux,
# linuxmusl/Alpine and darwin on both architectures). esbuild likewise resolves
# its binary from platform-specific optionalDependencies, and protobufjs' and
# @scarf/scarf's postinstalls are optional.
#
# Result: `npm install` / `npm ci` work on a clean machine with no build tools,
# and no dependency can run arbitrary code during install.
# npm still prints a warning listing scripts it skipped.
ignore-scripts=true
