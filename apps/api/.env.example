# Local development only.
# In production this is a *runtime* environment variable on the container, set
# in the deployment platform (Dokploy) and forwarded by docker-compose.yml.
# It is deliberately NOT a Docker build argument: a build `ARG`/`ENV` is
# persisted into the image config, so the published image would carry the real
# webhook in plain text. See docs/HOME_ASSISTANT_SETUP.md.
HOME_ASSISTANT_WEBHOOK_URL=http://<HA_HOST>:8123/api/webhook/<WEBHOOK_ID>
