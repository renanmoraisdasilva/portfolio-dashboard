{
  "name": "@portfolio-dashboard/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/web.js",
    "start:web": "node dist/web.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:compose": "docker compose -f ../../docker-compose.local.yml up --build",
    "test": "jest --config ./jest.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:docker": "docker build --target builder -t portfolio-dashboard-test -f Dockerfile ../.. && docker run --rm portfolio-dashboard-test sh -c \"npm test --workspace apps/api -- --runInBand\"",
    "test:coverage": "jest --config ./jest.config.cjs --coverage",
    "migrate:import": "ts-node src/migrate.ts",
    "migrate:init": "ts-node src/migrate.ts --init",
    "seed:local": "ts-node src/seed.ts ../../fixtures/portfolio_data.json",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@portfolio-dashboard/shared": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "lru-cache": "^10.4.3",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^4.6.3"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "tar": ">=7.5.11",
    "esbuild": ">=0.25.0",
    "brace-expansion": ">=2.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "@types/swagger-ui-express": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
